/* ===== 全局色板（现代暗黑主题高级灰调） ===== */
:root {
    /* 基础底色 */
    --bg-dark: #1E1E1E;
    --bg-card: #2B2D30;
    --bg-card-hover: #323437;

    /* 边框与分割线 (更细腻) */
    --border-soft: rgba(255, 255, 255, 0.08);
    --border-card: #1A1A1A;
    --border-card-hover: #4B5054;

    /* 文本颜色 */
    --text-title: #E6E6E6;
    --text-primary: #BFBFBF;
    --text-dim: #7A7A7A;
    --white: #FFFFFF;

    /* 功能色 (降低饱和度，提升专业感) */
    --color-success: #35673E;
    --color-success-hover: #44804E;
    --color-warning: #826025;
    --color-warning-hover: #9E7631;
    --color-info: #2A5876;
    --color-info-hover: #366D92;
    --color-danger: #8E352E;
    --color-danger-hover: #AD443B;

    /* 错误与重名状态 (采用半透明背景 + 亮色边框的现代做法) */
    --color-error-bg: rgba(142, 53, 46, 0.15);
    --color-error-text: #FF8B80;
    --color-duplicate-bg: rgba(142, 53, 46, 0.25);
    --color-duplicate-border: #E74C3C;

    /* 内容列宽：宽窗口下不让表单控件无限横向拉伸 */
    --content-max-width: 680px;
    --browse-width: 108px;
}

/* ===== 布局 ===== */
.main-container {
    padding: 12px;
    background-color: var(--bg-dark);
}

.section-title,
.toolbar-row,
.error-box,
.btn-add,
.filter-bar,
.namespace-field {
    width: 100%;
    max-width: var(--content-max-width);
    align-self: flex-start;
}

.entries-scroll {
    width: 100%;
    align-self: flex-start;
}

.entries-grid {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.entries-grid .entry-card {
    margin-bottom: 6px;
}

.entry-card-spacer {
    opacity: 0;
}

.toolbar-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 16px; /* 增加底部留白 */
}

.section-title {
    font-size: 15px; /* 稍微放大标题 */
    -unity-font-style: bold;
    margin-bottom: 12px;
    color: var(--text-title);

    /* Unity 更推荐拆分写 border */
    border-bottom-width: 1px;
    border-bottom-color: var(--border-soft);
    padding-bottom: 6px;
}

.filter-bar {
    margin-bottom: 12px;
    border-radius: 6px;
}

.source-row {
    align-items: center;
}

.source-field {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 8px;
}

.namespace-field {
    margin-right: 0;
    margin-bottom: 4px;
}

/* ===== 按钮体系：基类 + 修饰类 ===== */
.modern-button {
    flex-grow: 1;
    height: 30px; /* 略微收缩高度，更精致 */
    border-radius: 6px; /* 更圆润的倒角 */
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05); /* 极弱的高光边框 */
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--text-title);
    cursor: link;
    margin: 0 4px;
    background-color: transparent;
}

/* 按钮点击反馈 (Active状态) */
.modern-button:active {
    opacity: 0.8;
}

/* 修饰类：导入/导出 */
.btn-import {
    background-color: var(--color-success);
}

.btn-import:hover {
    background-color: var(--color-success-hover);
    color: var(--white);
}

.btn-export {
    background-color: var(--color-warning);
}

.btn-export:hover {
    background-color: var(--color-warning-hover);
    color: var(--white);
}

.btn-browse {
    width: var(--browse-width);
    min-width: var(--browse-width);
    max-width: var(--browse-width);
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 0;
    margin-right: 0;
}

/* 变体按钮：添加/删除 */
.btn-add,
.btn-delete {
    border-radius: 6px;
    font-size: 13px;
    margin: 8px 0;
    flex-grow: 0;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

.btn-add {
    background-color: var(--color-info);
    height: 34px;
}

.btn-add:hover {
    background-color: var(--color-info-hover);
    color: var(--white);
}

.btn-delete {
    background-color: var(--color-danger);
    height: 34px;
}

.btn-delete:hover {
    background-color: var(--color-danger-hover);
    color: var(--white);
}

.btn-normalize-keys {
    background-color: var(--color-danger);
    width: 100%;
    height: 30px;
    margin: 10px 0 0 0;
}

.btn-normalize-keys:hover {
    background-color: var(--color-danger-hover);
    color: var(--white);
}

/* ===== 提示框 (现代半透明风格) ===== */
.error-box {
    background-color: var(--color-error-bg);
    border-width: 1px;
    border-color: var(--color-danger);
    border-radius: 6px;
    padding: 10px;
    margin-bottom: 12px;
    border-left-width: 4px; /* 左侧加粗强调 */
}

.error-text {
    color: var(--color-error-text);
    white-space: normal;
    font-size: 12px;
    -unity-font-style: bold;
}

/* ===== 条目卡片 (微悬浮质感) ===== */
.entry-card {
    background-color: var(--bg-card);
    border-width: 1px;
    border-color: var(--border-card);
    border-radius: 8px;
    padding: 12px 10px; /* 增加内边距让内容呼吸 */
    margin-bottom: 10px;
    overflow: visible;
}

.entry-card:hover {
    border-color: var(--border-card-hover);
    background-color: var(--bg-card-hover);
}

.entry-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-soft);
    padding-bottom: 6px;
    margin-bottom: 10px;
}

.entry-index {
    color: var(--text-dim);
    font-size: 11px;
    -unity-font-style: bold;
}

/* 固定宽度标签优化 */
.entry-card .unity-label {
    min-width: 110px; /* 稍微缩小一点给输入框更多空间 */
    max-width: 110px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    color: var(--text-primary);
}

.entry-card .unity-text-field {
    margin-top: 4px;
    margin-bottom: 4px;
    overflow: visible;
}

/* 重名高亮 (去除了刺眼的红底，改用柔和红底+鲜艳边框) */
.duplicate-key-field,
.invalid-content-field {
    position: relative;
    overflow: visible;
}

.duplicate-key-outline,
.invalid-content-outline {
    position: absolute;
    left: -4px;
    right: -1px;
    top: 0;
    bottom: 0;
    background-color: var(--color-duplicate-bg);
    border-width: 1px;
    border-color: var(--color-duplicate-border);
    border-radius: 4px;
}

/* 强制内部输入对齐 */
.unity-text-field__input {
    padding: 5px 8px; /* 稍微增加输入框内部边距 */
    margin: 0;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.15); /* 加深输入框背景，使其凹陷 */
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

.entry-card .unity-text-field__input.invalid-key-input,
.entry-card .unity-text-field__input.invalid-content-input {
    background-color: var(--color-duplicate-bg);
    border-width: 1px;
    border-color: var(--color-duplicate-border);
}
